{
  "manifest_version": 3,
  "name": "Cookie Viewer & Exporter",
  "version": "1.0.0",
  "description": "查看当前页面的全部 Cookie，并导出为 JSON、Netscape cookies.txt、Header 串或 cURL 命令。",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "cookies",
    "activeTab",
    "downloads",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Cookie Viewer & Exporter",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "cookie-viewer@cookie.show",
      "strict_min_version": "115.0"
    }
  }
}
